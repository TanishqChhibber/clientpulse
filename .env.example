# ==============================================================================
# ClientPulse Environment Configuration
# ==============================================================================

# Supabase PostgreSQL Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
# Leave blank to run in local persistent SQLite mode during development/testing
SUPABASE_URL=
SUPABASE_KEY=

# MCP Server Configuration (Streamable HTTP)
# 127.0.0.1 = local only. Use 0.0.0.0 to expose it on the network, and then set MCP_AUTH_TOKEN.
MCP_HOST=127.0.0.1
MCP_PORT=8000
# When set, every MCP request must send "Authorization: Bearer <token>"
MCP_AUTH_TOKEN=

# When set, the agency dashboard asks for this password (public share links stay open)
APP_PASSWORD=

# Base URL for public report generation
PUBLIC_APP_URL=http://localhost:8501
